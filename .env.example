# ──────────────────────────────────────────────
# БезБоргів — environment variables template
# Copy to .env and fill in real values
# ──────────────────────────────────────────────

# PostgreSQL connection string (from Railway dashboard)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Telegram Bot token from @BotFather
BOT_TOKEN=1234567890:ABCDEFGHijklmnopqrstuvwxyz

# URL of the deployed Vercel frontend (set after Vercel deployment)
WEBAPP_URL=https://your-app.vercel.app

# How long (seconds) Telegram auth_date is valid; 0 disables the check
AUTH_MAX_AGE=86400

# Scheduler timezone for 10:00 payment notifications
SCHEDULER_TIMEZONE=Europe/Kyiv
